init_globals() {
    if [ "$0" != "/bin/bash" ]; then
        SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
        export RUN_SCRIPT_FILE="$(readlink -f "$0")"
    else
        export RUN_SCRIPT_FILE="$(readlink -f "${BASH_SOURCE[0]}")"
    fi

    #export TOP=$(git rev-parse --show-toplevel || $(dirname "${RUN_SCRIPT_FILE}"))
    export TOP=$(git rev-parse --show-toplevel 2>/dev/null || pwd) # pwd added for pipeline
    export AMDGPU_TARGETS=${AMDGPU_TARGETS:-"gfx942;gfx950"}

    # Derive GCC toolchain root from gcc on PATH for hipcc/clang to find
    # libstdc++ headers (e.g. <memory_resource> requires GCC >= 9).
    # Only used when compiling with hipcc (clang-based), not system GCC.
    if [ -z "${GCC_TOOLCHAIN_ROOT:-}" ]; then
        local _gcc_path
        _gcc_path=$(readlink -f "$(which gcc 2>/dev/null)" 2>/dev/null)
        if [ -n "${_gcc_path}" ]; then
            export GCC_TOOLCHAIN_ROOT=$(dirname "$(dirname "${_gcc_path}")")
        fi
    fi

    # Resolve the ROCm root dynamically so the hardcoded /opt/rocm is only a last
    # resort. Order: ROCM_PATH > ROCM_HOME > `rocm-sdk path --root` > `hipcc`
    # location > /opt/rocm. Covers pip/venv (TheRock), tarball and system installs.
    if [ -z "${ROCM_PATH:-}" ]; then
        if [ -n "${ROCM_HOME:-}" ]; then
            ROCM_PATH="${ROCM_HOME}"
        elif command -v rocm-sdk >/dev/null 2>&1; then
            ROCM_PATH="$(rocm-sdk path --root 2>/dev/null || true)"
        fi
    fi
    if [ -z "${ROCM_PATH:-}" ] && command -v hipcc >/dev/null 2>&1; then
        ROCM_PATH="$(dirname "$(dirname "$(command -v hipcc)")")"
    fi
    [ -z "${ROCM_PATH:-}" ] && ROCM_PATH="/opt/rocm"
    export ROCM_PATH

    # Put the ROCm runtime libs on the loader search path. hipcc links every
    # binary (even pure-C++ ones with no HIP code) against libamdhip64.so, so
    # CMake `try_run`/test probes fail at runtime with "libamdhip64.so.N:
    # cannot open shared object file" when ${ROCM_PATH}/lib is not on the
    # loader path (e.g. googlebenchmark's regex backend detection). Prepend it
    # while preserving any existing LD_LIBRARY_PATH.
    export LD_LIBRARY_PATH="${ROCM_PATH}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
}

