build_local_libhipcim_() {
    local source_folder=${1:-${TOP}}
    local build_type=${2:-debug}
    local build_type_str=${3:-Debug}
    local prefix=${4:-}
    local enable_coverage=${5:-OFF}
    local build_folder=${source_folder}/build-${build_type}
    local CMAKE_CMD=${CMAKE_CMD:-cmake}

    pushd ${source_folder} > /dev/null

    export CMAKE_PREFIX_PATH=${ROCM_PATH}/lib/cmake
    export CMAKE_MODULE_PATH=${ROCM_PATH}/lib/cmake

    # If coverage is enabled, ensure both C and C++ use hipcc
    local c_compiler_flag=""
    if [ "${enable_coverage}" = "ON" ]; then
        c_compiler_flag="-DCMAKE_C_COMPILER=hipcc"
    fi

    # Pass --gcc-toolchain to both the C++ (hipcc) and HIP-language compilers so
    # they resolve the correct libstdc++ headers/libs. On manylinux the ROCm
    # clang++ that CMake uses for enable_language(HIP) has no default GCC, so
    # without --gcc-toolchain in CMAKE_HIP_FLAGS the HIP compiler check fails at
    # link with: "ld.lld: error: unable to find library -lstdc++".
    local gcc_toolchain_flag=""
    if [ -n "${GCC_TOOLCHAIN_ROOT:-}" ]; then
        gcc_toolchain_flag="-DCMAKE_CXX_FLAGS=--gcc-toolchain=${GCC_TOOLCHAIN_ROOT} -DCMAKE_HIP_FLAGS=--gcc-toolchain=${GCC_TOOLCHAIN_ROOT}"
        # In coverage mode the C compiler is forced to hipcc (clang-based),
        # which also needs --gcc-toolchain to find libstdc++/crt; otherwise the
        # C-compiler ABI check fails with "ld.lld: unable to find library
        # -lstdc++". Plain gcc (non-coverage) must NOT get this clang-only flag.
        if [ "${enable_coverage}" = "ON" ]; then
            gcc_toolchain_flag="${gcc_toolchain_flag} -DCMAKE_C_FLAGS=--gcc-toolchain=${GCC_TOOLCHAIN_ROOT}"
        fi
    fi

    ${CMAKE_CMD} -S ${source_folder} -B ${build_folder} -G "Unix Makefiles" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE \
        -DCMAKE_PREFIX_PATH=${prefix} \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_BUILD_TYPE=${build_type_str} \
        -DCMAKE_INSTALL_PREFIX=${source_folder}/install \
        -DCMAKE_PREFIX_PATH=${prefix} \
        -DCMAKE_CXX_COMPILER=hipcc \
        ${c_compiler_flag} \
        ${gcc_toolchain_flag} \
        $(fetchcontent_offline_flag_ ${build_folder}) \
        $(fetchcontent_base_flag_ ${source_folder} ${build_type}) \
        -DENABLE_CODE_COVERAGE=${enable_coverage} \
        -DGPU_TARGETS="${AMDGPU_TARGETS}" \
        && mark_fetchcontent_complete_ ${build_folder}
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target hipcim -- -j $(nproc)
        ${CMAKE_CMD} --build ${build_folder} --config ${build_type_str} --target install -- -j $(nproc)

    popd
}

coverage_cxx_flags_() {
    # Echo the shared CMAKE_CXX_FLAGS for the plugin builds: any --gcc-toolchain,
    # plus (when $1 == ON) LLVM coverage instrumentation. The plugin CMake
    # projects do not honor ENABLE_CODE_COVERAGE, so the flags are injected
    # directly. Do NOT override the C compiler or add C coverage flags: the
    # bundled third-party C libs (e.g. openjpeg) fail to build when forced
    # through hipcc/clang++ (-x c) with coverage flags.
    local enable_coverage="${1:-OFF}"
    local cxx_flags=""
    if [ -n "${GCC_TOOLCHAIN_ROOT:-}" ]; then
        cxx_flags="--gcc-toolchain=${GCC_TOOLCHAIN_ROOT}"
    fi
    if [ "${enable_coverage}" = "ON" ]; then
        # Instrument only the HOST sub-compilation: hipcc compiles each TU for
        # host + amdgcn device, and there is no amdgcn LLVM profile runtime, so an
        # unscoped -fprofile-instr-generate makes the device link fail (undefined
        # __llvm_profile_* symbols). -Xarch_host scopes coverage to the host pass.
        cxx_flags="${cxx_flags} -Xarch_host -fprofile-instr-generate -Xarch_host -fcoverage-mapping -g"
    fi
    echo "${cxx_flags}"
}

