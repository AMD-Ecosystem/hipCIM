clean_build_keep_deps_() {
    # Delete build outputs from each given build directory but KEEP its `_deps/`
    # subdir (CMake FetchContent-downloaded 3rd-party sources) so rebuilds do not
    # re-download them. Entries are made writable first (3rd-party trees can be
    # read-only) so removal does not fail with "Directory not empty".
    local d
    for d in "$@"; do
        [ -d "$d" ] || continue
        find "$d" -mindepth 1 -maxdepth 1 ! -name '_deps' -exec chmod -R u+w {} + 2>/dev/null || true
        find "$d" -mindepth 1 -maxdepth 1 ! -name '_deps' -exec rm -rf {} + 2>/dev/null || true
    done
}

fetchcontent_cache_key_() {
    # Cache subdir for a build folder <src>/build-<type> (matches fetchcontent_base_flag_).
    local sf bt
    sf=$(dirname "$1")
    bt=$(basename "$1"); bt=${bt#build-}
    echo "${FETCHCONTENT_BASE_DIR}/$(basename "${sf}")-${bt}"
}

fetchcontent_deps_hash_() {
    # Hash of the dep declaration files so a dep add/bump invalidates the cache.
    find "$(dirname "$1")" -name 'build-*' -prune -o -name _deps -prune -o \
        -path '*/cmake/deps/*.cmake' -print0 2>/dev/null \
        | sort -z | xargs -0 cat 2>/dev/null | sha1sum | cut -d' ' -f1
}

fetchcontent_offline_flag_() {
    # Echo the FetchContent offline flag on a fresh configure (no CMakeCache) that
    # can reuse already-fetched sources instead of re-cloning: a preserved local
    # `_deps/` (clean_keep_deps) or a completed, dep-unchanged cache volume
    # (fetchcontent_base_flag_). A full `clean` / cache clear forces a fresh fetch.
    if [ -f "$1/CMakeCache.txt" ]; then return 0; fi
    if [ -d "$1/_deps" ]; then
        echo "-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
        return 0
    fi
    if [ -n "${FETCHCONTENT_BASE_DIR:-}" ]; then
        local marker
        marker="$(fetchcontent_cache_key_ "$1")/.complete"
        if [ -f "${marker}" ] && [ "$(cat "${marker}" 2>/dev/null)" = "$(fetchcontent_deps_hash_ "$1")" ]; then
            echo "-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
        fi
    fi
}

fetchcontent_base_flag_() {
    # Relocate FetchContent's 3rd-party sources to $FETCHCONTENT_BASE_DIR (an
    # optional cache volume), keyed per build dir so they survive clean rebuilds.
    # Unset => CMake default (${build}/_deps); unchanged behaviour.
    [ -n "${FETCHCONTENT_BASE_DIR:-}" ] || return 0
    echo "-DFETCHCONTENT_BASE_DIR=${FETCHCONTENT_BASE_DIR}/$(basename "$1")-$2"
}

mark_fetchcontent_complete_() {
    # Record (after a successful configure) that the keyed cache volume is fully
    # populated for the current dep set, so the next fresh configure reuses it.
    [ -n "${FETCHCONTENT_BASE_DIR:-}" ] || return 0
    local key
    key="$(fetchcontent_cache_key_ "$1")"
    mkdir -p "${key}"
    fetchcontent_deps_hash_ "$1" > "${key}/.complete"
}

build_local() {
    local subcommand="${1:-all}"
    local build_type="${2:-debug}"
    local build_type_str="Debug"
    local prefix=${3:-${ROCM_PATH:-/opt/rocm}}

    local major_version="$(cat ${TOP}/HIPCIM_VERSION | cut -d. -f1)" # major version number

    [ "$build_type" = "debug" ] && build_type_str="Debug"
    [ "$build_type" = "release" ] && build_type_str="Release"
    [ "$build_type" = "rel-debug" ] && build_type_str="RelWithDebInfo"

    local old_opt="$(shopt -op errexit);$(shopt -op nounset)" # save old shopts
    set -eu

    if [ "$subcommand" = "clean_cache" ]; then
        rm -f ${TOP}/build-*/CMakeCache.txt
        rm -f ${TOP}/cpp/plugins/cucim.kit.cuslide/build-*/CMakeCache.txt
        rm -f ${TOP}/cpp/plugins/cucim.kit.cumed/build-*/CMakeCache.txt
        rm -f ${TOP}/python/build-*/CMakeCache.txt
    fi

    if [ "$subcommand" = "clean" ]; then
        # Full wipe of build + install trees (original behaviour). Make the
        # trees writable first so read-only 3rd-party files inside _deps do not
        # cause "Directory not empty". Use `clean_keep_deps` to keep the
        # downloaded _deps and avoid re-downloading on the next build.
        chmod -R u+w ${TOP}/build-* ${TOP}/install \
            ${TOP}/cpp/plugins/cucim.kit.cuslide/build-* ${TOP}/cpp/plugins/cucim.kit.cuslide/install \
            ${TOP}/cpp/plugins/cucim.kit.cumed/build-* ${TOP}/cpp/plugins/cucim.kit.cumed/install \
            ${TOP}/python/build-* ${TOP}/python/install 2>/dev/null || true
        rm -rf ${TOP}/build-*
        rm -rf ${TOP}/install
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cuslide/build-*/
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cuslide/install
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cumed/build-*/
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cumed/install
        rm -rf ${TOP}/python/build-*
        rm -rf ${TOP}/python/install
    fi

    if [ "$subcommand" = "clean_keep_deps" ]; then
        # Like `clean` but PRESERVE each build dir's `_deps/` (FetchContent
        # downloads) so the next build reuses them offline instead of
        # re-downloading. Also sidesteps "Directory not empty" on read-only
        # _deps files. Use a full `clean` after a dependency version/URL change.
        clean_build_keep_deps_ \
            ${TOP}/build-* \
            ${TOP}/cpp/plugins/cucim.kit.cuslide/build-* \
            ${TOP}/cpp/plugins/cucim.kit.cumed/build-* \
            ${TOP}/python/build-*
        rm -rf ${TOP}/install
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cuslide/install
        rm -rf ${TOP}/cpp/plugins/cucim.kit.cumed/install
        rm -rf ${TOP}/python/install
    fi

    if [ "$subcommand" = "cpp" ] ; then
        build_local_libhipcim_ ${TOP} ${build_type} ${build_type_str} ${prefix}
        build_local_hipslide_ ${TOP}/cpp/plugins/cucim.kit.cuslide ${build_type} ${build_type_str} ${prefix}
        build_local_hipmed_ ${TOP}/cpp/plugins/cucim.kit.cumed ${build_type} ${build_type_str} ${prefix}
    fi

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "libhipcim" ]; then
        build_local_libhipcim_ ${TOP} ${build_type} ${build_type_str} ${prefix}
    fi

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "hipslide" ]; then
        build_local_hipslide_ ${TOP}/cpp/plugins/cucim.kit.cuslide ${build_type} ${build_type_str} ${prefix}
    fi

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "hipmed" ]; then
        build_local_hipmed_ ${TOP}/cpp/plugins/cucim.kit.cumed ${build_type} ${build_type_str} ${prefix}
    fi

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "hipcim" ]; then
        build_local_hipcim_ ${TOP}/python ${build_type} ${build_type_str} ${prefix}
    fi

    # Remove existing library files at python/cucim/src/cucim/clara
    rm -f ${TOP}/python/cucim/src/cucim/clara/*.so*

    if [ "$subcommand" = "all" ] || [ "$subcommand" = "hipcim" ]; then
        # We don't need to copy binary if executed by conda-build
        if [ "${CONDA_BUILD:-}" != "1" ]; then
            # Copy .so files from libcucim & cuslide/cumed's build folders to cuCIM's Python source folder
            # Since wheel file doesn't support symbolic link (https://github.com/pypa/wheel/issues/203),
            # we don't need to copy symbolic links. Instead copy only libcucim.so.${major_version} (without symbolic link)
            cp ${TOP}/build-$build_type/lib/libhipcim.so.${major_version} ${TOP}/python/cucim/src/cucim/clara/
            cp -P ${TOP}/cpp/plugins/cucim.kit.cuslide/build-$build_type/lib/hipcim* ${TOP}/python/cucim/src/cucim/clara/
            cp -P ${TOP}/cpp/plugins/cucim.kit.cumed/build-$build_type/lib/hipcim* ${TOP}/python/cucim/src/cucim/clara/

            # Copy .so files from pybind's build folder to cuCIM's Python source folder
            cp ${TOP}/python/build-$build_type/lib/hipcim/_cucim.*.so ${TOP}/python/cucim/src/cucim/clara/
        fi
    fi

    eval "${old_opt}" # restore old shopts
}


