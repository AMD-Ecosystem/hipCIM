# Build (once) and activate an LD_PRELOAD interposer that lets host-only LLVM
# coverage run on HIP code without aborting. AMD clang registers an offload
# "profile shadow" variable (__llvm_profile_sections_<cuid>) with the HIP runtime
# for every instrumented HIP TU; with host-only instrumentation it has no
# device-side symbol, so the HIP runtime aborts at fat-binary teardown
# ("Cannot create GlobalVar Obj for symbol: __llvm_profile_sections_*"). The
# interposer drops only those registrations; host coverage data and genuine
# device-variable registrations are unaffected. See scripts/hip_profile_shim.c.
enable_hip_profile_shim_() {
    local shim_src="${TOP}/scripts/hip_profile_shim.c"
    local shim_so="${TMPDIR:-/tmp}/hipcim_profile_shim_$(id -u).so"
    if [ ! -f "${shim_src}" ]; then
        c_echo Y "[WARN] ${shim_src} missing; HIP profile shim disabled (coverage run may abort)"
        return 1
    fi
    if [ ! -f "${shim_so}" ] || [ "${shim_src}" -nt "${shim_so}" ]; then
        if ! gcc -O2 -fPIC -shared -o "${shim_so}" "${shim_src}" -ldl 2>/dev/null; then
            c_echo Y "[WARN] failed to build HIP profile shim; coverage run may abort"
            return 1
        fi
    fi
    # LD_PRELOAD is whitespace- or colon-separated by the loader; use spaces so
    # the shim path composes cleanly with any existing value (a lone entry set
    # with spaces would be split on an appended ':').
    case " ${LD_PRELOAD:-} " in
        *" ${shim_so} "*) ;;  # already active
        *) export LD_PRELOAD="${shim_so}${LD_PRELOAD:+ $LD_PRELOAD}" ;;
    esac
    c_echo G "HIP profile shim active (drops __llvm_profile_sections HIP registration)"
}

test_python() {
    local test_type="${1:-all}"
    local test_component="${2:-all}"
    local result=0

    local testsuite=""
    local testsuite_unit_skimage="src"
    local testsuite_unit_clara="tests/unit"
    local testsuite_performance="tests/performance"

    if [ "$test_type" = "all" ] || [ "$test_type" = "unit" ]; then
        local testsuite="${testsuite_unit_skimage} ${testsuite_unit_clara}"
        [ "$test_component" = "skimage" ] && testsuite="${testsuite_unit_skimage}"
        [ "$test_component" = "clara" ] && testsuite="${testsuite_unit_clara}"

    fi
    if [ "$test_type" = "all" ] || [ "$test_type" = "performance" ]; then
        testsuite="${testsuite} ${testsuite_performance}"
    fi

    # When HIPCIM_CPP_PROFILE=ON, capture C++ coverage exercised by the Python
    # suite: pytest drives the compiled extension (cucim/clara/_cucim.so ->
    # libhipcim.so + plugins), so profiling it captures C++ paths the C++ unit
    # tests never reach. We point the import at the in-place build and drop the
    # instrumented core+plugin libs into its clara/ dir so the exercised C++ is
    # the instrumented build (bytes match install/lib, so profiles merge with
    # the C++-test run).
    if [ "${HIPCIM_CPP_PROFILE:-OFF}" = "ON" ]; then
        # The C++ extension pytest drives is host-instrumented HIP code; without
        # this interposer the HIP runtime aborts at process teardown.
        enable_hip_profile_shim_
        local _pyroot _clara _core _t _p
        _pyroot="$(ls -d ${TOP}/python/cucim/build/lib.*/ 2>/dev/null | head -1)"
        if [ -n "${_pyroot}" ] && [ -d "${_pyroot}cucim/clara" ]; then
            _clara="${_pyroot}cucim/clara"
            _core="$(ls -1 ${TOP}/install/lib/libhipcim.so.*.*.* 2>/dev/null | head -1)"
            [ -z "${_core}" ] && _core="$(ls -1 ${TOP}/install/lib/libhipcim.so 2>/dev/null | head -1)"
            if [ -n "${_core}" ]; then
                for _t in "${_clara}"/libhipcim.so*; do [ -f "${_t}" ] && cp -f "${_core}" "${_t}"; done
            fi
            for _p in ${TOP}/install/lib/hipcim.kit.*.so; do
                [ -f "${_p}" ] && cp -f "${_p}" "${_clara}/$(basename "${_p}")"
            done
            export PYTHONPATH="${_pyroot}${PYTHONPATH:+:$PYTHONPATH}"
            export LLVM_PROFILE_FILE="${TOP}/py_cov_%p_%9m.profraw"
            rm -f ${TOP}/py_cov_*.profraw
            c_echo G "C++ profiling ON for pytest (PYTHONPATH=${_pyroot}, LLVM_PROFILE_FILE set)"
        elif ls ${TOP}/python/cucim/src/cucim/clara/_cucim*.so >/dev/null 2>&1; then
            # No setuptools in-place build (e.g. PEP 660 editable install): cucim
            # imports from python/cucim/src/cucim/clara, where coverage_full's
            # `build_local hipcim` step already placed the freshly built
            # INSTRUMENTED core + plugin libs next to _cucim.so. Just enable LLVM
            # profiling so the C++ pytest drives emits py_cov_*.profraw.
            export LLVM_PROFILE_FILE="${TOP}/py_cov_%p_%9m.profraw"
            rm -f ${TOP}/py_cov_*.profraw
            c_echo G "C++ profiling ON for pytest (in-place src/cucim/clara, LLVM_PROFILE_FILE set)"
        else
            c_echo Y "HIPCIM_CPP_PROFILE=ON but no importable build under python/cucim/build/lib.* or src/cucim/clara; C++ profiling skipped"
        fi
    fi

    pushd $TOP/python/cucim
    run_command py.test --cache-clear -vv \
        --reruns 2 --reruns-delay 1 \
        --cov=cucim \
        --junitxml="$TOP/junit-cucim.xml" \
        --cov-config=$TOP/python/cucim/.coveragerc \
        --cov-report=xml:"$TOP/cucim-coverage.xml" \
        --cov-report term \
        ${testsuite}
    result=$?

    # Generate JSON from the collected coverage data, scoped to changed files
    # if a difflist is available. Coverage is recorded against the location the
    # package is imported from -- under python/cucim/build/lib.*/cucim/... when
    # HIPCIM_CPP_PROFILE=ON drives the in-place build (to pick up the
    # instrumented C++ libs), or site-packages/cucim/... for an installed wheel
    # -- NOT the source tree. So scope by the package-relative path
    # (*/cucim/<subpath>), which matches every layout; the source-tree path
    # (*/python/cucim/src/cucim/<subpath>) matches none of them and yields
    # "No data to report". coverage.py's '*' crosses '/', so the single leading
    # */ absorbs any prefix (build/lib.*, site-packages, src, ...).
    DIFFLIST_PYTHON_FILE="${TOP}/difflist-python.txt"
    if [ -f "${DIFFLIST_PYTHON_FILE}" ] && [ -s "${DIFFLIST_PYTHON_FILE}" ]; then
        INCLUDE_PATTERNS=$(cat "${DIFFLIST_PYTHON_FILE}" | sed -E 's#^.*/src/cucim/#cucim/#; s#^#*/#' | paste -sd ',' -)
        c_echo G "Scoping Python coverage to diff files: ${INCLUDE_PATTERNS}"
        run_command coverage json --ignore-errors \
            --include="${INCLUDE_PATTERNS}" \
            -o "$TOP/hipcim-coverage-python.json"
    else
        c_echo Y "Python diff list absent or empty; reporting full coverage."
        run_command coverage json -o "$TOP/hipcim-coverage-python.json"
    fi

    # Create comparison reports against baseline
    python3 $TOP/scripts/cucim_compare_junit.py                               \
         --baseline "$TOP/test_data/baseline/junit-cucim_latest.xml"          \
         --report "$TOP/junit-cucim.xml"                                      \
         --skip   "$TOP/test_data/baseline/junit-cucim_skiplist_latest.txt"   \
                                        > "$TOP/junit-cucim_report.txt" 2>&1
    info "JUnit comparison report written to \"$TOP/junit-cucim_report.txt\""

    python3 $TOP/scripts/cucim_compare_coverage.py                            \
         --baseline "$TOP/test_data/baseline/cucim-coverage_latest.xml"       \
         --report "$TOP/cucim-coverage.xml"                                   \
                                     > "$TOP/cucim-coverage_report.txt" 2>&1
    info "Coverage comparison report written to \"$TOP/cucim-coverage_report.txt\""

    popd

    return $result
}

test_cpp() {
	local install_dir=${TOP}/install
	local bin_dir=${install_dir}/bin
	# export library path
	export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:${install_dir}/lib

	# If code coverage is enabled, set profile output
	if [ "${ENABLE_COVERAGE}" = "ON" ]; then
		export LLVM_PROFILE_FILE="${TOP}/code_cov_%p_%9m.profraw"
		c_echo Y "Coverage profiling enabled - output to ${TOP}/*.profraw"
		# Instrumented HIP binaries abort in the HIP runtime at teardown unless
		# the profile-shadow-variable registration is dropped.
		enable_hip_profile_shim_
	fi

	# Generate synthetic fixtures (TIFF stripes + NIfTI/DICOM volumes); idempotent
	# and best-effort (skips if optional deps are missing).
	bash "${TOP}/test_data/gen_images.sh" || \
		c_echo Y "[WARN] gen_images.sh failed; some data-driven tests may be skipped"
	# Fetch vendor slides for the cuslide tests (best-effort, size-validated cache;
	# tier via CUCIM_TESTDATA_TIER). CUCIM_TESTDATA_DIR can point at a persistent
	# cache; when set, link the slides into test_data/private where the tests look.
	local priv_dir="${TOP}/test_data/private"
	local cache_dir="${CUCIM_TESTDATA_DIR:-${priv_dir}}"
	CUCIM_TESTDATA_DIR="${cache_dir}" bash "${TOP}/test_data/download_test_data.sh" || \
		c_echo Y "[WARN] download_test_data.sh failed; vendor-slide tests may be skipped"
	if [ "${cache_dir}" != "${priv_dir}" ]; then
		mkdir -p "${priv_dir}"
		for f in "${cache_dir}"/*.svs "${cache_dir}"/*.tif "${cache_dir}"/*.tiff; do
			if [ -f "${f}" ]; then
				ln -sf "${f}" "${priv_dir}/$(basename "${f}")"
			fi
		done
	fi
	cd ${bin_dir}
	# link test data folder for source images
	ln -sf ../../test_data .
	# execute the tests
	./cucim_benchmarks
	./cucim_primitives_benchmarks
	./cucim_tests
	./cumed_benchmarks
	./cumed_tests
	./cuslide_benchmarks
	./cuslide_tests
	./opj_compress -i test_data/image.pgm -o test_data/image.j2k
	./opj_decompress -i test_data/image.j2k -o test_data/image.pgm
	./opj_dump -i test_data/image.j2k
	if [ -f test_data/private/generic_tiff_000.tif ]; then
		./tiff_image test_data/private/generic_tiff_000.tif test_data/private
	else
		c_echo Y "[WARN] Skipping tiff_image: test_data/private/generic_tiff_000.tif not available"
	fi
	#./tiff_image test_data/private/philips_tiff_000.tif test_data/private

}

