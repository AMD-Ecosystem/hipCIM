generate_difflists_() {
    # Generate difflist.txt (C++) and difflist-python.txt (Python) from the diff
    # between <ref> and HEAD, so coverage commands scope their reports to the
    # changed (AMD-delta) files. Consumed by test_cpp_coverage / test_python /
    # coverage_full. Remove the difflists for full, unscoped coverage.
    local base_ref="${1}"
    if ! git -C "${TOP}" rev-parse --verify --quiet "${base_ref}^{commit}" >/dev/null 2>&1; then
        c_echo_err R "--diff: ref '${base_ref}' not found locally. Fetch it first, e.g.:"
        c_echo_err R "  git fetch https://github.com/rapidsai/cucim.git refs/tags/${base_ref}:refs/tags/${base_ref}"
        exit 1
    fi
    c_echo G "Scoping coverage to diff: ${base_ref}...HEAD"
    # Also drop rocJPEG/cuFile (GPU/GDS-only, unreachable here) to match the
    # llvm-cov --ignore-filename-regex list, so the delta % isn't inflated.
    git -C "${TOP}" diff --name-only --diff-filter=AM "${base_ref}...HEAD" \
        | grep -E '\.(cpp|h|cu|cuh)$' \
        | grep -Eiv 'rocjpeg|cufile' > "${TOP}/difflist.txt" || true
    git -C "${TOP}" diff --name-only --diff-filter=AM "${base_ref}...HEAD" \
        | grep 'python/cucim/src' | grep -v '/tests/' | grep -v '/test_' \
        | grep -E '\.py$' > "${TOP}/difflist-python.txt" || true
    c_echo Y "  C++ diff files:    $(wc -l < "${TOP}/difflist.txt")"
    c_echo Y "  Python diff files: $(wc -l < "${TOP}/difflist-python.txt")"
}

parse_args() {
    local OPTIND
    DIFF_REF=""
    # Extract the global `--diff <ref>` option (a long option; the getopts loop
    # below only handles single-char flags). When set, coverage runs are scoped
    # to files changed between <ref> and HEAD. Everything else is passed through.
    local _passthru=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --diff)   DIFF_REF="${2:?--diff requires a commit id or tag}"; shift 2 ;;
            --diff=*) DIFF_REF="${1#--diff=}"; shift ;;
            *)        _passthru+=("$1"); shift ;;
        esac
    done
    set -- "${_passthru[@]}"

    while getopts 'yh' option;
    do
        case "${option}" in
            # a)
            #     VALUE=${OPTARG}
            #     ;;
            y)
                ALWAYS_YES=true;
                ;;
            h)
                print_usage
                exit 1
                ;;
            *)
                ;;
        esac
    done
    shift $((OPTIND-1))

    CMD="$1"
    shift

    ARGS=("$@")
}

print_usage() {
    set +x
    echo_err
    echo_err "USAGE: $0 [command] [arguments]..."
    echo_err ""
    c_echo_err W "Global Arguments"
    c_echo_err Y "    --diff <ref> " w "-------------------  Scope coverage (test_cpp_coverage/test_python/coverage_full) to files changed vs <ref> (commit/tag)"
    echo_err
    c_echo_err W "Command List"
    c_echo_err Y "    help  " w "----------------------------  Print detailed description for a given argument (command name)"
    echo_err "$(get_list_of_available_commands "${RUN_SCRIPT_FILE}" | my_cat_prefix " ")"
    echo_err
}

print_cmd_help_messages() {
    local cmd="$1"
    if [ -n "${cmd}" ]; then
        if type ${cmd}_desc > /dev/null 2>&1; then
            ${cmd}_desc
            exit 0
        else
            c_echo_err R "Command '${cmd}' doesn't exist!"
            exit 1
        fi
    fi
    print_usage
    return 0
}


main() {
    local ret=0
    parse_args "$@"

    # --diff only scopes the coverage commands. Generating difflists for any
    # other command is pointless and harmful: it can abort on a missing ref or
    # leave stray difflist*.txt files that silently scope a later coverage run.
    if [ -n "${DIFF_REF:-}" ]; then
        case "$CMD" in
            test_python|test_cpp_coverage|coverage_full)
                generate_difflists_ "${DIFF_REF}"
                ;;
            *)
                c_echo_err Y "--diff ignored for '${CMD}': only applies to test_python, test_cpp_coverage, coverage_full."
                ;;
        esac
    fi

    case "$CMD" in
help)
            print_cmd_help_messages "${ARGS[@]}"
            exit 0
            ;;
        ''|main)
            print_usage
            ;;
        *)
            if type ${CMD} > /dev/null 2>&1; then
                "$CMD" "${ARGS[@]}"
            else
                print_usage
                exit 1
            fi
            ;;
    esac
    ret=$?
    if [ -n "${SCRIPT_DIR}" ]; then
        exit $ret
    fi
}

init_globals

if [ -n "${SCRIPT_DIR}" ]; then
    main "$@"
fi


