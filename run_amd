cpp_coverage_desc() { echo 'Build C++ code with coverage and generate reports

Arguments:
  $1 - build type [debug|release] (default: debug)

Builds the C++ project with code coverage enabled, runs tests, and generates HTML coverage report.
'
}

build_cpp_coverage() {
    local build_type="${1:-debug}"
    local build_type_str="Debug"

    [ "$build_type" = "release" ] && build_type_str="Release"
    [ "$build_type" = "rel-debug" ] && build_type_str="RelWithDebInfo"

    c_echo G "Building with code coverage enabled..."

    # Clean and build with coverage. Use clean_keep_deps so repeated coverage
    # rebuilds reuse the downloaded 3rd-party _deps instead of re-fetching them.
    build_local clean_keep_deps
    build_local_libhipcim_ ${TOP} ${build_type} ${build_type_str} "" "ON"
    build_local_hipslide_ ${TOP}/cpp/plugins/cucim.kit.cuslide ${build_type} ${build_type_str} "" "ON"
    build_local_hipmed_ ${TOP}/cpp/plugins/cucim.kit.cumed ${build_type} ${build_type_str} "" "ON"
}

coverage_full() {
    local build_type="${1:-release}"
    c_echo G "Full coverage: instrumented C++ build + C++ tests + pytest (C++ & Python)"

    if [ -s "${TOP}/difflist.txt" ] || [ -s "${TOP}/difflist-python.txt" ]; then
        c_echo Y "Note: difflist.txt/difflist-python.txt present -> coverage will be"
        c_echo Y "      scoped to those diff files. Remove them for FULL (all-file) data."
    fi

    # Start from a clean set of profiles so stale runs do not leak in.
    rm -f ${TOP}/code_cov_*.profraw ${TOP}/py_cov_*.profraw

    # 1) Instrumented build (core libhipcim + cuslide/cumed plugins).
    build_cpp_coverage "${build_type}"

    # 1b) Rebuild the Python bindings. build_cpp_coverage's clean removed the
    #     in-place python/cucim/src/cucim/clara/*.so, so pytest could not import
    #     cucim.clara._cucim. This rebuilds _cucim.so and copies the freshly
    #     built INSTRUMENTED core + plugin libs next to it, so the C++ that
    #     pytest drives is instrumented too (feeds py_cov_*.profraw).
    build_local hipcim "${build_type}"

    # 2) Python unit suite: coverage.py (Python lines) + LLVM profiling of the
    #    C++ extension it drives (emits py_cov_*.profraw).
    export HIPCIM_CPP_PROFILE=ON
    test_python unit
    unset HIPCIM_CPP_PROFILE

    # 3) C++ unit tests, then merge ALL profraw (C++ tests + pytest) into one
    #    combined C++ report. test_cpp_coverage's profraw discovery picks up the
    #    py_cov_*.profraw too, so no extra wiring is needed.
    test_cpp_coverage "${build_type}"

    c_echo G "Full combined coverage complete:"
    c_echo Y "  C++ (C++ tests + pytest): ${TOP}/coverage_report/hipcim-coverage-cpp.json"
    c_echo Y "  Python (coverage.py)    : ${TOP}/hipcim-coverage-python.json, ${TOP}/cucim-coverage.xml"
}

coverage_full_desc() { echo 'Run full combined coverage (C++ tests + pytest-driven C++ + Python)

Builds instrumented C++ (core + plugins), runs the C++ unit tests and the Python
unit suite (which drives the C++ extension) under LLVM profiling, then merges both
profiles into a single C++ coverage report. A Python coverage.py report is produced
too.

Arguments:
  $1 - build type [debug|release|rel-debug] (default: release)

Requires an importable in-place build at python/cucim/build/lib.* (from the normal
Python build). Produces FULL (unfiltered) reports when difflist.txt /
difflist-python.txt are absent; if present, coverage is scoped to those diff files.
'
}

test_cpp_coverage() {
    local build_type="${1:-debug}"
    local build_type_str="Debug"

    [ "$build_type" = "release" ] && build_type_str="Release"
    [ "$build_type" = "rel-debug" ] && build_type_str="RelWithDebInfo"

    # Run tests with coverage enabled
    export ENABLE_COVERAGE=ON
    export LLVM_PROFILE_FILE="${TOP}/code_cov_%p_%9m.profraw"

    # Add the additional llvm flags for code coverage
    export ENABLE_CODE_COVERAGE=1

    c_echo G "Running tests with coverage..."
    test_cpp

    # Generate coverage report
    c_echo G "Generating coverage report..."
    cd ${TOP}

    # Find LLVM tools — prefer the versioned LLVM 20 binaries installed by the
    # official llvm.sh script. Otherwise fall back to the ROCm SDK's own llvm
    # binaries (${ROCM_PATH}/lib/llvm/bin), which match the LLVM version of the
    # ROCm clang that instruments the C++ (required for the pip ROCm SDK, where
    # there is no /opt/rocm), then to whatever else is on PATH.
    LLVM_PROFDATA="/usr/bin/llvm-profdata-20"
    if [ ! -f "${LLVM_PROFDATA}" ]; then
        for dir in ${ROCM_PATH}/lib/llvm/bin /opt/rocm/llvm/bin /opt/rocm/bin /usr/bin; do
            if [ -f "${dir}/llvm-profdata" ]; then
                LLVM_PROFDATA="${dir}/llvm-profdata"
                break
            fi
        done
    fi

    LLVM_COV="/usr/bin/llvm-cov-20"
    if [ ! -f "${LLVM_COV}" ]; then
        for dir in ${ROCM_PATH}/lib/llvm/bin /opt/rocm/llvm/bin /opt/rocm/bin /usr/bin; do
            if [ -f "${dir}/llvm-cov" ]; then
                LLVM_COV="${dir}/llvm-cov"
                break
            fi
        done
    fi

    # Merge profile data
    find . -type f -name "*.profraw" > rawprofiles.list
    if [ ! -s rawprofiles.list ]; then
        c_echo_err R "No profraw files found! Coverage may not be working."
        return 1
    fi

    MERGED_PROFDATA="merged.profdata"
    ${LLVM_PROFDATA} merge --sparse --input-files=rawprofiles.list --output=${MERGED_PROFDATA}

    # Find objects
    OBJECTS=""
    for lib in ${TOP}/build-${build_type}/lib/libhipcim.so ${TOP}/install/lib/libhipcim.so; do
        [ -f "$lib" ] && OBJECTS="${OBJECTS} -object=${lib}"
    done
    # Include instrumented plugin shared libraries (cuslide/cumed) so their
    # coverage is captured too, not just core libhipcim.
    for plugin in ${TOP}/install/lib/hipcim.kit.*.so; do
        [ -f "$plugin" ] && OBJECTS="${OBJECTS} -object=${plugin}"
    done
    for exe in ${TOP}/install/bin/*tests ${TOP}/install/bin/*benchmarks; do
        [ -f "$exe" ] && OBJECTS="${OBJECTS} -object=${exe}"
    done

    # Run log — use append (>>) throughout so no earlier output is lost.
    RUN_LOG="${TOP}/coverage_report.log"
    ${LLVM_COV} --version >> $RUN_LOG 2>&1

    # Diff list is kept for downstream post-processing of the JSON; it is NOT
    # passed to llvm-cov as positional source-file arguments.  The tester
    # container contains only compiled binaries — source files are absent — so
    # llvm-cov would fail (or silently produce 0-byte output) if given paths
    # that do not exist on disk or do not match the absolute build-time paths
    # embedded in the binary's debug info.
    DIFFLIST_FILE="${TOP}/difflist.txt"
    if [ -f "${DIFFLIST_FILE}" ] && [ -s "${DIFFLIST_FILE}" ]; then
        c_echo Y "Diff list found (${DIFFLIST_FILE}); will be available for post-processing."
    else
        c_echo Y "No diff list found; full coverage will be reported."
    fi

    # Print diagnostic info to aid debugging
    c_echo Y "LLVM_PROFDATA: ${LLVM_PROFDATA}"
    c_echo Y "LLVM_COV:      ${LLVM_COV}"
    c_echo Y "OBJECTS:       ${OBJECTS}"

    # Generate HTML report (best-effort; llvm-cov show needs source files on
    # disk to annotate — it may fail in tester containers without the source tree)
    mkdir -p ${TOP}/coverage_report
    ${LLVM_COV} show \
        --instr-profile=${MERGED_PROFDATA} \
        --ignore-filename-regex=".*test.*" \
        --ignore-filename-regex=".*benchmark.*" \
        --ignore-filename-regex=".*third_party.*" \
        --ignore-filename-regex=".*/_deps/.*" \
        --ignore-filename-regex=".*rocjpeg.*" \
        --ignore-filename-regex=".*cufile.*" \
        --format=html \
        --output-dir=${TOP}/coverage_report \
        ${OBJECTS} 2>>$RUN_LOG \
        || c_echo Y "⚠ llvm-cov show failed (source files likely absent); continuing"

    # Generate JSON report (full coverage; difflist.txt available for downstream filtering).
    # rocjpeg/cufile are GPU/GDS-only (unreachable here); generate_difflists_ excludes them too.
    echo "Generating JSON coverage report (export)"
    ${LLVM_COV} export                                    \
        --instr-profile=${MERGED_PROFDATA}                \
        --ignore-filename-regex=".*test.*"                \
        --ignore-filename-regex=".*benchmark.*"           \
        --ignore-filename-regex=".*third_party.*"         \
        --ignore-filename-regex=".*/_deps/.*"             \
        --ignore-filename-regex=".*rocjpeg.*"             \
        --ignore-filename-regex=".*cufile.*"              \
        ${OBJECTS} > ${TOP}/coverage_report/hipcim-coverage-cpp.json 2>>$RUN_LOG
    JSON_EXIT=$?
    if [ ${JSON_EXIT} -ne 0 ]; then
        c_echo_err R "llvm-cov export failed (exit ${JSON_EXIT}). See ${RUN_LOG} for details."
    fi

    # Filter the full coverage JSON to only the files in difflist.txt.
    # llvm-cov records absolute build-time paths; the diff list has relative
    # paths.  The Python script matches via str.endswith() so the build prefix
    # does not matter.  If the diff list is absent or empty the full JSON is
    # kept as-is.
    if [ -f "${DIFFLIST_FILE}" ] && [ -s "${DIFFLIST_FILE}" ]; then
        c_echo G "Filtering coverage JSON to diff files..."
        python3 ${TOP}/scripts/hipcim_filter_cpp_coverage.py \
            ${DIFFLIST_FILE} \
            ${TOP}/coverage_report/hipcim-coverage-cpp.json \
            ${TOP}/coverage_report/hipcim-coverage-cpp.json
    else
        c_echo Y "Diff list absent or empty; retaining full coverage JSON."
    fi

    # Generate summary
    c_echo G "Coverage Summary:"
    ${LLVM_COV} report \
        --instr-profile=merged.profdata \
        --ignore-filename-regex=".*test.*" \
        --ignore-filename-regex=".*benchmark.*" \
        --ignore-filename-regex=".*third_party.*" \
        --ignore-filename-regex=".*rocjpeg.*" \
        --ignore-filename-regex=".*cufile.*" \
        ${OBJECTS} 2>>$RUN_LOG

    c_echo G "Coverage report generated at: ${TOP}/coverage_report/index.html"
    c_echo Y "View with: cd ${TOP}/coverage_report && python3 -m http.server 8080"

    # Clean up
    rm -f rawprofiles.list
}

cpp_coverage() {
    local build_type="${1:-debug}"
    local build_type_str="Debug"

    [ "$build_type" = "release" ] && build_type_str="Release"
    [ "$build_type" = "rel-debug" ] && build_type_str="RelWithDebInfo"

    # Clean and build with coverage
    build_cpp_coverage $@

    # Run tests with coverage enabled
    export ENABLE_COVERAGE=ON
    export LLVM_PROFILE_FILE="${TOP}/code_cov_%p_%9m.profraw"

    c_echo G "Running tests with coverage..."
    test_cpp

    # Generate coverage report
    c_echo G "Generating coverage report..."
    cd ${TOP}

    # Find LLVM tools
    LLVM_COV=""
    LLVM_PROFDATA=""
    for dir in /opt/rocm/llvm/bin /opt/rocm/bin /usr/bin; do
        if [ -f "${dir}/llvm-cov" ]; then
            LLVM_COV="${dir}/llvm-cov"
            LLVM_PROFDATA="${dir}/llvm-profdata"
            break
        fi
    done

    if [ -z "${LLVM_COV}" ]; then
        LLVM_COV="llvm-cov"
        LLVM_PROFDATA="llvm-profdata"
    fi

    # Merge profile data
    find . -type f -name "*.profraw" > rawprofiles.list
    if [ ! -s rawprofiles.list ]; then
        c_echo_err R "No profraw files found! Coverage may not be working."
        return 1
    fi

    ${LLVM_PROFDATA} merge --sparse --input-files=rawprofiles.list --output=merged.profdata

    # Find objects
    OBJECTS=""
    for lib in ${TOP}/build-${build_type}/lib/libhipcim.so ${TOP}/install/lib/libhipcim.so; do
        [ -f "$lib" ] && OBJECTS="${OBJECTS} -object=${lib}"
    done
    # Include instrumented plugin shared libraries (cuslide/cumed) so their
    # coverage is captured too, not just core libhipcim.
    for plugin in ${TOP}/install/lib/hipcim.kit.*.so; do
        [ -f "$plugin" ] && OBJECTS="${OBJECTS} -object=${plugin}"
    done
    for exe in ${TOP}/install/bin/*tests ${TOP}/install/bin/*benchmarks; do
        [ -f "$exe" ] && OBJECTS="${OBJECTS} -object=${exe}"
    done

    # Generate HTML report
    ${LLVM_COV} show \
        --instr-profile=merged.profdata \
        --ignore-filename-regex=".*test.*" \
        --ignore-filename-regex=".*benchmark.*" \
        --ignore-filename-regex=".*third_party.*" \
        --ignore-filename-regex=".*rocjpeg.*" \
        --ignore-filename-regex=".*cufile.*" \
        --format=html \
        --output-dir=coverage_report \
        ${OBJECTS}

    # Generate summary
    c_echo G "Coverage Summary:"
    ${LLVM_COV} report \
        --instr-profile=merged.profdata \
        --ignore-filename-regex=".*test.*" \
        --ignore-filename-regex=".*benchmark.*" \
        --ignore-filename-regex=".*third_party.*" \
        --ignore-filename-regex=".*rocjpeg.*" \
        --ignore-filename-regex=".*cufile.*" \
        ${OBJECTS}

    c_echo G "Coverage report generated at: ${TOP}/coverage_report/index.html"
    c_echo Y "View with: cd coverage_report && python3 -m http.server 8080"

    # Clean up
    rm -f rawprofiles.list
}



